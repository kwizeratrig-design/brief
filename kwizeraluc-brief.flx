"name":"3DSMD_0402_1005Metric","rawName":"3DSMD_0402_1005Metric.step","storageName":"document_assets/3DSMD_0402_1005Metric-f67a8003-8022-4cca-213f-88262e58f588.step","uid":"f2ad7594-cc63-2059-ba3b-7e66131d1b9f"},"f571b2d1-f0f2-b2f0-b2d5-ed2932e221b7":{"fileType":"kicad_mod","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"SMD_MiniMELF_MMA-0204.kicad_mod","name":"SMD_MiniMELF_MMA-0204","rawName":"SMD_MiniMELF_MMA-0204.kicad_mod","storageName":"document_assets/SMD_MiniMELF_MMA-0204-540218ce-3b43-5ef1-50c6-48212839bfdd.kicad_mod","uid":"f571b2d1-f0f2-b2f0-b2d5-ed2932e221b7"},"f5b29da4-1292-c546-20cd-fddf3019f667":{"fileType":"step","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"3DSMD_0603_1608Metric.step","name":"3DSMD_0603_1608Metric","rawName":"3DSMD_0603_1608Metric.step","storageName":"document_assets/3DSMD_0603_1608Metric-e9e0c079-dac5-361b-03ae-a1496ca997ab.step","uid":"f5b29da4-1292-c546-20cd-fddf3019f667"},"f5fc4778-d260-d2c1-81a8-c582269fb0ad":{"fileType":"kicad_mod","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"SMD_0603_1608Metric.kicad_mod","name":"SMD_0603_1608Metric","rawName":"SMD_0603_1608Metric.kicad_mod","storageName":"document_assets/SMD_0603_1608Metric-81c4836b-6448-8220-0eae-1905ab724f8c.kicad_mod","uid":"f5fc4778-d260-d2c1-81a8-c582269fb0ad"},"f6c513f1-516e-7e9e-0182-25ec594cf2dd":{"fileType":"kicad_mod","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"SMD_0815_2038Metric.kicad_mod","name":"SMD_0815_2038Metric","rawName":"SMD_0815_2038Metric.kicad_mod","storageName":"document_assets/SMD_0815_2038Metric-b52f372d-2d5b-aeca-17ec-e0da0fbf2a0e.kicad_mod","uid":"f6c513f1-516e-7e9e-0182-25ec594cf2dd"},"fa016024-1f22-445c-bdea-44f582c7a320":{"fileType":"png","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":true,"label":"generic-resistor-thumb.png","name":"generic-resistor-thumb","rawName":"generic-resistor-thumb.png","storageName":"document_assets/generic-resistor-thumb-96c803b1-a411-48fe-8465-57d005540c08.png","uid":"fa016024-1f22-445c-bdea-44f582c7a320"},"ffa84dad-f46f-7557-fdc4-f32992676362":{"fileType":"kicad_mod","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"V_AXIAL-P2.54_D3.2.kicad_mod","name":"V_AXIAL-P2.54_D3.2","rawName":"V_AXIAL-P2.54_D3.2.kicad_mod","storageName":"document_assets/V_AXIAL-P2.54_D3.2-759f8638-2040-9a50-6c53-a792aec7e07d.kicad_mod","uid":"ffa84dad-f46f-7557-fdc4-f32992676362"}},"behaviour":"const footprintNode = flux.getNodeById(\"bd79d98f-3542-c68b-7d08-c8a9fe1b19d2\") as PcbLayoutNode;\nconst modelNode = flux.getNodeById(\"03889df1-6435-acaa-19c8-c65242c5255a\") as PcbLayoutNode;\n\n// This will return array of all assets with file type .kicad_mod\nconst footprintAssetId = flux.assets\n    .filter((asset) => asset.fileType === \"kicad_mod\") // Filter by file type\n    .map((asset) => asset.name) // Extract the name\n    .sort(); // Sort the resulting names\n\n// This will return array of all assets with file type .step\nconst modelAssetId = flux.assets\n    .filter((asset) => asset.fileType === \"step\") // Filter by file type\n    .map((asset) => asset.name) // Extract the name\n    .sort(); // Sort the resulting names\n\nif (footprintNode || modelNode) {\n    const assetFootprintRule = footprintNode.rules.find((rule) => rule.key === \"asset\");\n    const assetModelRule = modelNode.rules.find((rule) => rule.key === \"asset\");\n\n    flux.on(\"setup\", () => {\n        const property = flux.properties.find((prop) => prop.name === \"Package\");\n        if (property) {\n            changeFootprintAsset(property.value);\n            changeModelAsset(property.value)\n        }\n    });\n\n    // Listen to any change in the Package property, set the footprint and model \n    // based on the current package value.\n    flux.on(\"propertyChange\", (event: PropertyChangeEvent) => {\n        if (event.property_name === \"Package\") {\n            changeFootprintAsset(event.value);\n            changeModelAsset(event.value);\n        }\n    });\n\n    function changeFootprintAsset(propertyValue: any) {\n        if (assetFootprintRule) {\n            const index = footprintAssetId.indexOf(propertyValue);\n            if (index >= 0 && index <= 32) {\n                assetFootprintRule.value = footprintAssetId[index];\n                footprintNode.name = footprintAssetId[index];\n            } else {\n                assetFootprintRule.value = \"SMD_0603_1608Metric\";\n                footprintNode.name = \"SMD_0603_1608Metric\";\n            }\n        }\n    };\n\n    function changeModelAsset(propertyValue: any) {\n        if (assetModelRule) {\n            const index = footprintAssetId.indexOf(propertyValue);\n            if (index >= 0 && index <= 32) {\n                assetModelRule.value = modelAssetId[index];\n                modelNode.name = modelAssetId[index];\n            } else {\n                assetModelRule.value = \"3DSMD_0603_1608Metric\";\n                modelNode.name = \"3DSMD_0603_1608Metric\";\n            }\n        }\n    };\n};","behaviour_has_errors":false,"behaviour_is_derived":false,"controls":{"_dataStructureIsArray":true},"created_at":1781026988627,"description":"A generic fixed resistor ideal for rapid circuit topology development. Its footprint automatically adapts based on the selected package case code—supporting 0402, 0603, 0805, 1203, and many other standard SMD packages, as well as axial horizontal and vertical configurations.\n\nSave precious design time by seamlessly add more information to this part (value, footprint, etc.) as it becomes available.\n\nStandard resistor values:\n1.0 ohm, 10 ohm, 100 ohm, 1.0k ohm, 10k ohm, 100k ohm, 1.0M ohm\n1.1 ohm, 11 ohm, 110 ohm, 1.1k ohm, 11k ohm, 110k ohm, 1.1M ohm\n1.2 ohm, 12 ohm, 120 ohm, 1.2k ohm, 12k ohm, 120k ohm, 1.2M ohm\n1.3 ohm, 13 ohm, 130 ohm, 1.3k ohm, 13k ohm, 130k ohm, 1.3M ohm\n1.5 ohm, 15 ohm, 150 ohm, 1.5k ohm, 15k ohm, 150k ohm, 1.5M ohm\n1.6 ohm, 16 ohm, 160 ohm, 1.6k ohm, 16k ohm, 160k ohm, 1.6M ohm\n1.8 ohm, 18 ohm, 180 ohm, 1.8K ohm, 18k ohm, 180k ohm, 1.8M ohm\n2.0 ohm, 20 ohm, 200 ohm, 2.0k ohm, 20k ohm, 200k ohm, 2.0M ohm\n2.2 ohm, 22 ohm, 220 ohm, 2.2k ohm, 22k ohm, 220k ohm, 2.2M ohm\n2.4 ohm, 24 ohm, 240 ohm, 2.4k ohm, 24k ohm, 240k ohm, 2.4M ohm\n2.7 ohm, 27 ohm, 270 ohm, 2.7k ohm, 27k ohm, 270k ohm, 2.7M ohm\n3.0 ohm, 30 ohm, 300 ohm, 3.0K ohm, 30K ohm, 300K ohm, 3.0M ohm\n3.3 ohm, 33 ohm, 330 ohm, 3.3k ohm, 33k ohm, 330k ohm, 3.3M ohm\n3.6 ohm, 36 ohm, 360 ohm, 3.6k ohm, 36k ohm, 360k ohm, 3.6M ohm\n3.9 ohm, 39 ohm, 390 ohm, 3.9k ohm, 39k ohm, 390k ohm, 3.9M ohm\n4.3 ohm, 43 ohm, 430 ohm, 4.3k ohm, 43K ohm, 430K ohm, 4.3M ohm\n4.7 ohm, 47 ohm, 470 ohm, 4.7k ohm, 47k ohm, 470k ohm, 4.7M ohm\n5.1 ohm, 51 ohm, 510 ohm, 5.1k ohm, 51k ohm, 510k ohm, 5.1M ohm\n5.6 ohm, 56 ohm, 560 ohm, 5.6k ohm, 56k ohm, 560k ohm, 5.6M ohm\n6.2 ohm, 62 ohm, 620 ohm, 6.2k ohm, 62K ohm, 620K ohm, 6.2M ohm\n6.8 ohm, 68 ohm, 680 ohm, 6.8k ohm, 68k ohm, 680k ohm, 6.8M ohm\n7.5 ohm, 75 ohm, 750 ohm, 7.5k ohm, 75k ohm, 750k ohm, 7.5M ohm\n8.2 ohm, 82 ohm, 820 ohm, 8.2k ohm, 82k ohm, 820k ohm, 8.2M ohm\n9.1 ohm, 91 ohm, 910 ohm, 9.1k ohm, 91k ohm, 910k ohm, 9.1M ohm\n\n#generics #CommonPartsLibrary","document_import_uid":"1adf6486-92d1-d412-141f-d48db518295d","extracted_element_cache":{"880f28ef-cf41-0acc-4a98-ce0afa37b0c2":{"diagram_position":{"flip":false,"orientation":0,"scene_cursor_position":true,"x":-9.4,"y":159.2},"label":"P2","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"designator_prefix":{"name":"Designator Prefix","value":"P"},"part_type":{"name":"Part Type","value":"Terminal"},"pin_number":{"name"